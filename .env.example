# Copy to .env and fill in. Never commit .env.

# Review dashboard login (http://YOUR_SERVER:8080)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Public https URL of this server (only needed for Metricool, which downloads videos from it)
PUBLIC_BASE_URL=

# Twitch app (https://dev.twitch.tv/console/apps): live checks, viewer clips, discovery
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude API key (https://console.anthropic.com): AI clip scoring + titles
ANTHROPIC_API_KEY=

# YouTube Shorts (python -m clipper auth-youtube --client-secrets client_secret.json)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API (python -m clipper auth-tiktok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=

# Metricool API (Advanced plan): Account settings -> API
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
