# The installer (deploy/install.sh) creates .env for you. Every key below can also be pasted on the
# dashboard's Setup page instead, which is easier; values saved there win over this file.
# Never commit .env.

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Web address. The installer sets these from the server's IP (DOMAIN=1-2-3-4.sslip.io,
# DOMAIN_ALT=1-2-3-4.nip.io as a backup). Use your own domain by setting DOMAIN and PUBLIC_BASE_URL.
DOMAIN=
DOMAIN_ALT=
PUBLIC_BASE_URL=

# Twitch app (https://dev.twitch.tv/console/apps): live checks, viewer clips, discovery
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude API key (https://console.anthropic.com): AI clip scoring + titles
ANTHROPIC_API_KEY=

# YouTube Shorts: Google OAuth client of type "TVs and Limited Input devices".
# The refresh token comes from the Connect YouTube button (or: python -m clipper auth-youtube).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API. The refresh token comes from the Connect TikTok button.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Metricool API (Advanced plan): Account settings -> API
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
